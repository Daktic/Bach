# Copy to .env.local and fill in. Never commit real values: this repo is public.

# Auth.js — signs session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Invite list (ADR 0009). guestId=email pairs, comma separated; guest ids are in
# src/lib/data/guests.ts. List a guest twice to allow two emails (e.g. Google + Apple).
# Empty = nobody can sign in.
GUEST_EMAILS=gberg=you@example.com

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# Flight search on /flights/book (SerpAPI Google Flights)
SERP_API_KEY=

# Flight-number lookup on /me (Aviationstack)
AVIATIONSTACK_API_KEY=
